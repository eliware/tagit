{
    "name": "@eliware/tagit",
    "type": "module",
    "version": "2.5.0",
    "description": "AI-oriented release notes, safe preflight and dry-run validation, and cross-platform Git release automation.",
    "main": "bin/tagit-cli.mjs",
    "exports": {
        ".": "./bin/tagit-cli.mjs",
        "./tagit": "./bin/tagit.mjs",
        "./push": "./bin/push.mjs",
        "./upstream": "./bin/upstream.mjs"
    },
    "files": [
        "bin/",
        "src/",
        "docs/",
        "specs/",
        "examples/",
        "scripts/typecheck.mjs",
        "scripts/run-global-test.mjs",
        "README.md",
        "LICENSE",
        "RELEASE_NOTES.md"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "start": "node bin/tagit-cli.mjs",
        "test": "eliware-test",
        "lint": "eliware-test --lint",
        "typecheck": "node scripts/typecheck.mjs",
        "pack": "npm pack --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/eliware/tagit.git"
    },
    "keywords": [
        "tagit",
        "versioning",
        "git",
        "git-tag",
        "git-release",
        "automation",
        "release-automation",
        "nodejs",
        "npm",
        "php",
        "composer",
        "package.json",
        "composer.json",
        "release",
        "publishing",
        "cli",
        "version-bumping",
        "ci",
        "github-actions"
    ],
    "author": "Eliware <eli@eliware.org>",
    "license": "MIT",
    "engines": {
        "node": ">=26"
    },
    "bugs": {
        "url": "https://github.com/eliware/tagit/issues"
    },
    "homepage": "https://github.com/eliware/tagit#readme",
    "devDependencies": {
        "@eliware/test": "^4.0.0"
    },
    "dependencies": {
        "@eliware/common": "^2.0.0"
    },
    "bin": {
        "tagit": "bin/tagit-cli.mjs",
        "push": "bin/push-cli.mjs",
        "upstream": "bin/upstream-cli.mjs"
    }
}
