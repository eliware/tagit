{
  "name": "@eliware/tagit",
  "type": "module",
  "version": "6.2.0",
  "description": "Deterministic release preflight and publication verification for Eliware packages.",
  "main": "bin/tagit-cli.mjs",
  "exports": {
    ".": "./bin/tagit-cli.mjs",
    "./tagit": "./bin/tagit.mjs",
    "./push": "./bin/push.mjs",
    "./upstream": "./bin/upstream.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "specs/",
    "examples/",
    "scripts/typecheck.mjs",
    "README.md",
    "LICENSE",
    "RELEASE_NOTES.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "private": false,
  "scripts": {
    "start": "node bin/tagit-cli.mjs",
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eliware/tagit.git"
  },
  "keywords": [
    "tagit",
    "versioning",
    "git",
    "git-tag",
    "git-release",
    "automation",
    "release-automation",
    "nodejs",
    "npm",
    "php",
    "composer",
    "package.json",
    "composer.json",
    "release",
    "publishing",
    "cli",
    "version-bumping",
    "ci",
    "github-actions"
  ],
  "author": "Eliware <eliware@eliware.org>",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "bugs": {
    "url": "https://github.com/eliware/tagit/issues"
  },
  "homepage": "https://github.com/eliware/tagit#readme",
  "devDependencies": {
    "@eliware/test": "^6.0.1",
    "@eliware/redact": "^8.0.0",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "@eliware/common": "^2.0.0"
  },
  "eliware": {
    "conventions": {
      "version": "8.0",
      "apply": [
        "general",
        "node",
        "application",
        "cli",
        "npm-published"
      ],
      "exemptions": []
    },
    "authority": {
      "authoritativeFor": [
        "TagIt release preflight and publication verification behavior."
      ],
      "notAuthoritativeFor": [
        "Target repository implementation, CI state, publication state, deployment, or operations."
      ]
    },
    "crosslinks": [
      {
        "path": "../docs/authority-map.json",
        "relation": "relatedAuthority",
        "authoritativeFor": "Shared platform and documentation authority."
      },
      {
        "path": "../conventions/specs/README.md",
        "relation": "relatedAuthority",
        "authoritativeFor": "Applicable repository convention specifications."
      }
    ]
  },
  "bin": {
    "tagit": "bin/tagit-cli.mjs",
    "push": "bin/push-cli.mjs",
    "upstream": "bin/upstream-cli.mjs"
  }
}
