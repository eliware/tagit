{
    "name": "@eliware/tagit",
    "type": "module",
    "version": "2.2.2",
    "description": "AI-oriented release notes, preflight validation, and cross-platform Git release automation.",
    "main": "bin/tagit-cli.mjs",
    "exports": {
        ".": "./bin/tagit-cli.mjs"
    },
    "files": [
        "bin/",
        "src/",
        "scripts/typecheck.mjs",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "start": "node bin/tagit-cli.mjs",
        "test": "eliware-test",
        "lint": "eliware-test --lint",
        "typecheck": "node scripts/typecheck.mjs",
        "gitops:pin": "node bin/gitops-pin.mjs",
        "pack": "npm pack --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliware/tagit.git"
    },
    "keywords": [
        "tagit",
        "versioning",
        "git",
        "git-tag",
        "automation",
        "release-automation",
        "nodejs",
        "npm",
        "php",
        "composer",
        "package.json",
        "composer.json",
        "release",
        "publishing",
        "cli",
        "version-bumping",
        "webpack"
    ],
    "author": "Eli Sterling, eliware.org <eli@eliware.org>",
    "license": "MIT",
    "engines": {
        "node": ">=26"
    },
    "bugs": {
        "url": "https://github.com/eliware/tagit/issues"
    },
    "homepage": "https://github.com/eliware/tagit#readme",
    "devDependencies": {
        "@eliware/test": "^2.0.0"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/?(*.)+(spec|test).[jt]s?(x)",
            "**/?(*.)+(spec|test).mjs",
            "**/?(*.)+(spec|test).cjs"
        ]
    },
    "dependencies": {
        "@eliware/common": "^2.0.0"
    },
    "bin": {
        "tagit": "bin/tagit-cli.mjs",
        "push": "bin/push-cli.mjs",
        "upstream": "bin/upstream-cli.mjs"
    }
}
