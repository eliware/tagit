#!/bin/bash

if [ "$#" -eq 0 ]; then
  current_time=$(date +"%Y-%m-%d %H:%M:%S")
  message="$current_time"
else
  message="$*"
fi

git fetch upstream
if git merge upstream/master -m "$message"; then
  git push
else
  echo "Merge conflicts detected. Files needing attention:"
  git diff --name-only --diff-filter=U
fi
